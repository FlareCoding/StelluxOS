musl has no execinfo, so stack traces walk the frame pointer chain and print
bare addresses for llvm-symbolizer to resolve against the unstripped binary.

--- a/base/debug/stack_trace_posix.cc
+++ b/base/debug/stack_trace_posix.cc
@@ -1051,6 +1051,9 @@
   return base::saturated_cast<size_t>(
       backtrace(const_cast<void**>(trace.data()),
                 base::saturated_cast<int>(trace.size())));
+#elif BUILDFLAG(CAN_UNWIND_WITH_FRAME_POINTERS)
+  // Without backtrace(3), stack traces walk the frame pointer chain
+  return base::debug::TraceStackFramePointers(trace, 0);
 #else
   return 0;
 #endif
@@ -1073,6 +1076,17 @@
 #if defined(HAVE_BACKTRACE)
   PrintBacktraceOutputHandler handler;
   ProcessBacktrace(addresses(), prefix_string, &handler);
+#else
+  // Without libc symbolization every frame prints as a bare address, which
+  // llvm-symbolizer resolves afterwards against the unstripped binary.
+  char buf[32];
+  for (const void* address : addresses()) {
+    PrintToStderr(prefix_string.c_str());
+    PrintToStderr("0x");
+    internal::itoa_r(reinterpret_cast<intptr_t>(address), 16, 12, buf);
+    PrintToStderr(buf);
+    PrintToStderr("\n");
+  }
 #endif
 }
 
@@ -1082,6 +1096,14 @@
     cstring_view prefix_string) const {
   StreamBacktraceOutputHandler handler(os);
   ProcessBacktrace(addresses(), prefix_string, &handler);
+}
+#else
+void StackTrace::OutputToStreamWithPrefixImpl(
+    std::ostream* os,
+    cstring_view prefix_string) const {
+  for (const void* address : addresses()) {
+    (*os) << prefix_string << address << "\n";
+  }
 }
 #endif
 
