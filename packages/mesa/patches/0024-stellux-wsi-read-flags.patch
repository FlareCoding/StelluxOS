+/* The GPU_INFO flags that say whether stlxdm reads buffers with the CPU or
+ * with the GPU, which decides where a swapchain places its buffers */
+#define STELLUX_READ_FLAGS (STLXWIN_GPU_CPU_READS | STLXWIN_GPU_GPU_READS)
