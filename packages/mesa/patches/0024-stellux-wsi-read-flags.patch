-/* Prefers a host-visible type outside video memory, since stlxdm reads the
- * buffers with the CPU, which system memory serves fastest */
+/* Prefers a host-visible type outside video memory, which the CPU reads
+ * fastest */
 static uint32_t
-wsi_stellux_select_buffer_memory_type(const struct wsi_device *wsi,
+wsi_stellux_select_system_memory_type(const struct wsi_device *wsi,
                                       uint32_t type_bits)
 {
    return wsi_select_memory_type(wsi, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT,
                                  VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
                                  type_bits);
+}
+
+/* Prefers video memory the CPU cannot map, which the GPU reads fastest, and
+ * takes system memory on a device without such a type */
+static uint32_t
+wsi_stellux_select_video_memory_type(const struct wsi_device *wsi,
+                                     uint32_t type_bits)
+{
+   u_foreach_bit(t, type_bits) {
+      VkMemoryPropertyFlags flags =
+         wsi->memory_props.memoryTypes[t].propertyFlags;
+      bool is_device_local = flags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT;
+      bool is_host_visible = flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT;
+      if (is_device_local && !is_host_visible)
+         return t;
+   }
+
+   return wsi_stellux_select_system_memory_type(wsi, type_bits);
 }
 
