+
+/* Finds a lost surface, and a swapchain out of date once a GPU_INFO changed
+ * the read flags its buffers were placed by */
+static VkResult
+wsi_stellux_swapchain_check_gpu_info(struct wsi_stellux_swapchain *chain)
+{
+   stlxwin_gpu_info gpu_info;
+   VkResult result =
+      wsi_stellux_surface_get_gpu_info(&chain->surface->base, &gpu_info);
+   if (result != VK_SUCCESS)
+      return result;
+
+   if ((gpu_info.flags & STELLUX_READ_FLAGS) != chain->read_flags)
+      return VK_ERROR_OUT_OF_DATE_KHR;
+
+   return VK_SUCCESS;
 }
 
