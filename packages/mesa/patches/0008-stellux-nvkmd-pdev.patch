+#ifdef NVK_STELLUX
+VkResult
+nvk_enumerate_stellux_physical_devices(struct vk_instance *_instance)
+{
+   struct nvk_instance *instance = (struct nvk_instance *)_instance;
+   VkResult result;
+
+   for (uint32_t gpu_index = 0;; gpu_index++) {
+      struct nvkmd_pdev *nvkmd;
+      result = nvkmd_try_create_pdev_for_stellux(gpu_index,
+                                                 &instance->vk.base,
+                                                 instance->debug_flags,
+                                                 &nvkmd);
+      if (result == VK_ERROR_INCOMPATIBLE_DRIVER)
+         continue;
+      if (result != VK_SUCCESS)
+         goto fail;
+      if (nvkmd == NULL)
+         return VK_SUCCESS;
+
+      struct vk_physical_device *pdev;
+      result = nvk_create_physical_device(instance, nvkmd, &pdev);
+      if (result == VK_ERROR_INCOMPATIBLE_DRIVER)
+         continue;
+      if (result != VK_SUCCESS)
+         goto fail;
+
+      list_addtail(&pdev->link, &instance->vk.physical_devices.list);
+   }
+
+fail:
+   /* The runtime keeps the devices a failed hook added and calls the hook
+    * again on the next enumeration
+    */
+   list_for_each_entry_safe(struct vk_physical_device, pdev,
+                            &instance->vk.physical_devices.list, link) {
+      list_del(&pdev->link);
+      nvk_physical_device_destroy(pdev);
+   }
+
+   return result;
+}
+#endif
