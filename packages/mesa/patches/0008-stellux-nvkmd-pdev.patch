+   { 0x1b3, "GB203" },
+   { 0x1b5, "GB205" },
+   { 0x1b6, "GB206" },
+   { 0x1b7, "GB207" },
+};
+
+const char *
+nv_chipset_name(uint16_t chipset)
+{
+   for (uint32_t i = 0; i < ARRAY_SIZE(chipset_names); i++) {
+      if (chipset_names[i].chipset == chipset)
+         return chipset_names[i].name;
+   }
+
+   return NULL;
+}
