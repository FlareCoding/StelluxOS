 static inline void
 nvkmd_pdev_destroy(struct nvkmd_pdev *pdev)
 {
--- /dev/null
+++ b/src/nouveau/vulkan/nvkmd/stellux/nvkmd_stellux.h
@@ -0,0 +1,29 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef NVKMD_STELLUX_H
+#define NVKMD_STELLUX_H 1
+
+#include "nvkmd/nvkmd.h"
+
+#include <stdint.h>
+#include <stlx/gpu_abi.h>
+
+/* The nvkmd over Stellux's /dev/gpuN files, whose calls <stlx/gpu_abi.h>
+ * defines. A pdev owns its GPU's open file.
+ */
+
+struct nvkmd_stellux_pdev {
+   struct nvkmd_pdev base;
+
+   int fd;
+};
+
+NVKMD_DECL_SUBCLASS(pdev, stellux);
+
+VkResult nvkmd_stellux_try_create_pdev(uint32_t gpu_index,
+                                       struct vk_object_base *log_obj,
+                                       enum nvk_debug debug_flags,
+                                       struct nvkmd_pdev **pdev_out);
+
+#endif /* NVKMD_STELLUX_H */
--- /dev/null
+++ b/src/nouveau/vulkan/nvkmd/stellux/nvkmd_stellux_pdev.c
@@ -0,0 +1,163 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "nvkmd_stellux.h"
+
+#include "util/cache_ops.h"
+#include "util/u_memory.h"
+#include "vk_log.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+/* A pdev offers no sync type, since it creates no dev */
+static const struct vk_sync_type *const nvkmd_stellux_sync_types[] = {
+   NULL,
+};
+
+static void
+nvkmd_stellux_fill_dev_info(const struct gpu_info *info,
+                            struct nv_device_info *dev_info)
+{
+   const uint16_t chipset = info->nvidia.chipset;
+   const uint8_t sm = nv_sm_for_chipset(chipset);
+
+   *dev_info = (struct nv_device_info) {
+      .type = NV_DEVICE_TYPE_DIS,
+      .device_id = info->device_id,
+      .chipset = chipset,
+      .pci = {
+         .domain = info->pci_segment,
+         .bus = info->pci_bus,
+         .dev = info->pci_slot,
+         .func = info->pci_function,
+         .revision_id = info->pci_revision,
+      },
+      .sm = sm,
+      .gpc_count = info->nvidia.gpc_count,
+      .tpc_count = info->nvidia.tpc_count,
+      .mp_per_tpc = nv_mp_per_tpc_for_chipset(chipset),
+      .max_warps_per_mp = nv_max_warps_per_mp_for_sm(sm),
+      .has_transfer_queue = (info->queue_kinds & (1u << GPU_QUEUE_COPY)) != 0,
+      .nc_atom_size_B = util_cache_granularity(),
+      .cls_copy = info->nvidia.class_copy,
+      .cls_eng2d = info->nvidia.class_2d,
+      .cls_eng3d = info->nvidia.class_3d,
+      .cls_m2mf = info->nvidia.class_m2mf,
+      .cls_compute = info->nvidia.class_compute,
+      .cls_gpfifo = info->nvidia.class_gpfifo,
+      .vram_size_B = info->video_size,
+      .bar_size_B = info->mappable_video_size,
+   };
+
+   STATIC_ASSERT(sizeof(dev_info->device_name) == sizeof(info->name));
+   memcpy(dev_info->device_name, info->name, sizeof(info->name));
+   dev_info->device_name[sizeof(dev_info->device_name) - 1] = '\0';
+
+   const char *chipset_name = nv_chipset_name(chipset);
+   if (chipset_name != NULL) {
+      snprintf(dev_info->chipset_name, sizeof(dev_info->chipset_name),
+               "%s", chipset_name);
+   } else {
+      snprintf(dev_info->chipset_name, sizeof(dev_info->chipset_name),
+               "NV%X", chipset);
+   }
+
+   nv_init_shared_mem_sizes(dev_info);
+}
+
+VkResult
+nvkmd_stellux_try_create_pdev(uint32_t gpu_index,
+                              struct vk_object_base *log_obj,
+                              enum nvk_debug debug_flags,
+                              struct nvkmd_pdev **pdev_out)
+{
+   char path[32];
+   snprintf(path, sizeof(path), "/dev/gpu%u", gpu_index);
+
+   int fd = open(path, O_RDWR | O_CLOEXEC);
+   if (fd < 0) {
+      if (errno == ENOENT) {
+         *pdev_out = NULL;
+         return VK_SUCCESS;
+      }
+
+      return vk_errorf(log_obj, VK_ERROR_INITIALIZATION_FAILED,
+                       "open() failed on %s: %m", path);
+   }
+
+   struct gpu_info info = { 0 };
+   if (ioctl(fd, GPU_GET_INFO, &info) != 0) {
+      VkResult result = vk_errorf(log_obj, VK_ERROR_INCOMPATIBLE_DRIVER,
+                                  "GPU_GET_INFO failed on %s: %m", path);
+      close(fd);
+      return result;
+   }
+
+   if (info.backend != GPU_BACKEND_NVIDIA) {
+      close(fd);
+      return VK_ERROR_INCOMPATIBLE_DRIVER;
+   }
+
+   struct nvkmd_stellux_pdev *pdev = CALLOC_STRUCT(nvkmd_stellux_pdev);
+   if (pdev == NULL) {
+      close(fd);
+      return vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+
+   pdev->base.ops = &nvkmd_stellux_pdev_ops;
+   pdev->base.debug_flags = debug_flags;
+   nvkmd_stellux_fill_dev_info(&info, &pdev->base.dev_info);
+   pdev->base.kmd_info = (struct nvkmd_info) {
+      .has_get_vram_used = true,
+   };
+   pdev->base.bind_align_B = info.page_size;
+   pdev->base.sync_types = nvkmd_stellux_sync_types;
+   pdev->fd = fd;
+
+   *pdev_out = &pdev->base;
+
+   return VK_SUCCESS;
+}
+
+static void
+nvkmd_stellux_pdev_destroy(struct nvkmd_pdev *_pdev)
+{
+   struct nvkmd_stellux_pdev *pdev = nvkmd_stellux_pdev(_pdev);
+
+   close(pdev->fd);
+   FREE(pdev);
+}
+
+static uint64_t
+nvkmd_stellux_pdev_get_vram_used(struct nvkmd_pdev *_pdev)
+{
+   struct nvkmd_stellux_pdev *pdev = nvkmd_stellux_pdev(_pdev);
+   const uint64_t vram_size_B = pdev->base.dev_info.vram_size_B;
+
+   struct gpu_memory memory = { 0 };
+   if (ioctl(pdev->fd, GPU_GET_MEMORY, &memory) != 0)
+      return vram_size_B;
+
+   return vram_size_B - memory.video_free;
+}
+
+static VkResult
+nvkmd_stellux_create_dev(struct nvkmd_pdev *pdev,
+                         struct vk_object_base *log_obj,
+                         struct nvkmd_dev **dev_out)
+{
+   return vk_errorf(log_obj, VK_ERROR_INITIALIZATION_FAILED,
+                    "The Stellux nvkmd cannot create a device");
+}
+
+const struct nvkmd_pdev_ops nvkmd_stellux_pdev_ops = {
+   .destroy = nvkmd_stellux_pdev_destroy,
+   .get_vram_used = nvkmd_stellux_pdev_get_vram_used,
+   .create_dev = nvkmd_stellux_create_dev,
+};
