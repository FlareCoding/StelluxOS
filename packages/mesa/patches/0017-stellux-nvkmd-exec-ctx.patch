+++ b/src/nouveau/vulkan/nvkmd/stellux/nvkmd_stellux_ctx.c
@@ -0,0 +1,335 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "nvkmd_stellux.h"
+
+#include "util/u_memory.h"
+#include "vk_log.h"
+
+#include <errno.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+/* The command ranges one GPU_SUBMIT takes */
+#define NVKMD_STELLUX_RANGES_MAX \
+   ((uint32_t)(GPU_COMMANDS_BYTES_MAX / sizeof(struct gpu_nvidia_range)))
+
+static int
+sync_timeline(struct vk_sync *sync)
+{
+   return container_of(sync, struct nvkmd_stellux_sync, base)->timeline;
+}
+
+static uint32_t
+range_count(const struct nvkmd_stellux_ctx *ctx)
+{
+   return util_dynarray_num_elements(&ctx->ranges, struct gpu_nvidia_range);
+}
+
+static void
+drop_batch(struct nvkmd_stellux_ctx *ctx)
+{
+   util_dynarray_clear(&ctx->ranges);
+   ctx->wait_count = 0;
+}
+
+static void
+destroy_queue(struct nvkmd_stellux_dev *dev, uint32_t queue)
+{
+   struct gpu_queue_args args = {
+      .context = dev->context,
+      .queue = queue,
+   };
+
+   /* Succeeds for any queue the context holds, lost or not */
+   ioctl(dev->fd, GPU_QUEUE_DESTROY, &args);
+}
+
+static int
+submit_ioctl(struct nvkmd_stellux_dev *dev, struct gpu_submit_args *args)
+{
+   return ioctl(dev->fd, GPU_SUBMIT, args) == 0 ? 0 : errno;
+}
+
+/* Drops the batch whether or not it is taken. A chained part leaves the next
+ * batch waiting on its private point, so the parts after a failed one fail.
+ */
+static VkResult
+submit_batch(struct nvkmd_stellux_ctx *ctx, struct vk_object_base *log_obj,
+             uint32_t signal_count, const struct vk_sync_signal *signals,
+             bool chained)
+{
+   struct nvkmd_stellux_dev *dev = nvkmd_stellux_dev(ctx->base.dev);
+
+   assert(signal_count < GPU_POINTS_MAX);
+   struct gpu_point points[GPU_POINTS_MAX];
+   for (uint32_t i = 0; i < signal_count; i++) {
+      points[i] = (struct gpu_point) {
+         .timeline = sync_timeline(signals[i].sync),
+         .value = signals[i].signal_value,
+      };
+   }
+
+   const struct gpu_point private_point = {
+      .timeline = ctx->timeline,
+      .value = ctx->last_point + 1,
+   };
+   points[signal_count] = private_point;
+
+   struct gpu_submit_args args = {
+      .context = dev->context,
+      .queue = ctx->queue,
+      .commands = (uintptr_t)util_dynarray_begin(&ctx->ranges),
+      .waits = (uintptr_t)ctx->waits,
+      .signals = (uintptr_t)points,
+      .commands_size = ctx->ranges.size,
+      .wait_count = ctx->wait_count,
+      .signal_count = signal_count + 1,
+   };
+   int err = submit_ioctl(dev, &args);
+
+   /* A full queue holds the last GPU_QUEUE_PENDING_MAX submissions, and the
+    * kernel takes another once the oldest has reached its private point
+    */
+   if (err == EBUSY) {
+      const struct gpu_point oldest = {
+         .timeline = ctx->timeline,
+         .value = private_point.value - GPU_QUEUE_PENDING_MAX,
+      };
+      VkResult result = nvkmd_stellux_wait(log_obj->device, dev->fd, &oldest,
+                                           1, true, UINT64_MAX);
+      if (result != VK_SUCCESS) {
+         drop_batch(ctx);
+         return result;
+      }
+
+      err = submit_ioctl(dev, &args);
+   }
+
+   drop_batch(ctx);
+
+   if (err != 0) {
+      /* Loses the device with the kernel's reason for the lost context */
+      if (err == EIO)
+         nvkmd_stellux_dev_check(dev, log_obj->device, true);
+
+      return nvkmd_stellux_error(log_obj, NVKMD_STELLUX_CALL_SUBMIT, err);
+   }
+
+   ctx->last_point = private_point.value;
+   if (chained) {
+      ctx->waits[0] = private_point;
+      ctx->wait_count = 1;
+   }
+
+   return VK_SUCCESS;
+}
+
+static void
+nvkmd_stellux_ctx_destroy(struct nvkmd_ctx *_ctx)
+{
+   struct nvkmd_stellux_ctx *ctx = nvkmd_stellux_ctx(_ctx);
+   struct nvkmd_stellux_dev *dev = nvkmd_stellux_dev(ctx->base.dev);
+
+   list_del(&ctx->link);
+
+   destroy_queue(dev, ctx->queue);
+   close(ctx->timeline);
+
+   util_dynarray_fini(&ctx->ranges);
+   FREE(ctx);
+}
+
+static VkResult
+nvkmd_stellux_ctx_wait(struct nvkmd_ctx *_ctx,
+                       struct vk_object_base *log_obj,
+                       uint32_t wait_count,
+                       const struct vk_sync_wait *waits)
+{
+   struct nvkmd_stellux_ctx *ctx = nvkmd_stellux_ctx(_ctx);
+
+   for (uint32_t i = 0; i < wait_count; i++) {
+      if (ctx->wait_count == GPU_POINTS_MAX) {
+         VkResult result = submit_batch(ctx, log_obj, 0, NULL, true);
+         if (result != VK_SUCCESS)
+            return result;
+      }
+
+      ctx->waits[ctx->wait_count++] = (struct gpu_point) {
+         .timeline = sync_timeline(waits[i].sync),
+         .value = waits[i].wait_value,
+      };
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvkmd_stellux_ctx_exec(struct nvkmd_ctx *_ctx,
+                       struct vk_object_base *log_obj,
+                       uint32_t exec_count,
+                       const struct nvkmd_ctx_exec *execs)
+{
+   struct nvkmd_stellux_ctx *ctx = nvkmd_stellux_ctx(_ctx);
+
+   uint32_t run_start = 0;
+   while (run_start < exec_count) {
+      /* An incomplete push goes in one submission with the push after it */
+      uint32_t run_end = run_start + 1;
+      while (run_end < exec_count && execs[run_end - 1].incomplete)
+         run_end++;
+
+      const uint32_t run_count = run_end - run_start;
+      if (run_count > NVKMD_STELLUX_RANGES_MAX) {
+         drop_batch(ctx);
+         return vk_errorf(log_obj, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                          "%u pushes that must go in one GPU_SUBMIT pass "
+                          "its limit of %u command ranges", run_count,
+                          NVKMD_STELLUX_RANGES_MAX);
+      }
+
+      if (range_count(ctx) + run_count > NVKMD_STELLUX_RANGES_MAX) {
+         VkResult result = submit_batch(ctx, log_obj, 0, NULL, true);
+         if (result != VK_SUCCESS)
+            return result;
+      }
+
+      struct gpu_nvidia_range *ranges =
+         util_dynarray_grow(&ctx->ranges, struct gpu_nvidia_range, run_count);
+      if (ranges == NULL) {
+         drop_batch(ctx);
+         return vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+      }
+
+      for (uint32_t i = 0; i < run_count; i++) {
+         const struct nvkmd_ctx_exec *exec = &execs[run_start + i];
+         ranges[i] = (struct gpu_nvidia_range) {
+            .va = exec->addr,
+            .size = exec->size_B,
+            .flags = exec->no_prefetch ? GPU_COMMANDS_GPU_WRITTEN : 0,
+         };
+      }
+
+      run_start = run_end;
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvkmd_stellux_ctx_flush(struct nvkmd_ctx *_ctx,
+                        struct vk_object_base *log_obj)
+{
+   struct nvkmd_stellux_ctx *ctx = nvkmd_stellux_ctx(_ctx);
+
+   if (range_count(ctx) == 0 && ctx->wait_count == 0)
+      return VK_SUCCESS;
+
+   return submit_batch(ctx, log_obj, 0, NULL, false);
+}
+
+static VkResult
+nvkmd_stellux_ctx_signal(struct nvkmd_ctx *_ctx,
+                         struct vk_object_base *log_obj,
+                         uint32_t signal_count,
+                         const struct vk_sync_signal *signals)
+{
+   struct nvkmd_stellux_ctx *ctx = nvkmd_stellux_ctx(_ctx);
+
+   if (signal_count == 0)
+      return nvkmd_stellux_ctx_flush(&ctx->base, log_obj);
+
+   /* Each part keeps one signal for the private point, and the parts after
+    * the one with the work carry the rest
+    */
+   for (uint32_t start = 0; start < signal_count;
+        start += GPU_POINTS_MAX - 1) {
+      const uint32_t count = MIN2(signal_count - start, GPU_POINTS_MAX - 1);
+      VkResult result = submit_batch(ctx, log_obj, count, &signals[start],
+                                     start + count < signal_count);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvkmd_stellux_ctx_sync(struct nvkmd_ctx *_ctx,
+                       struct vk_object_base *log_obj)
+{
+   struct nvkmd_stellux_ctx *ctx = nvkmd_stellux_ctx(_ctx);
+   struct nvkmd_stellux_dev *dev = nvkmd_stellux_dev(ctx->base.dev);
+
+   VkResult result = nvkmd_stellux_ctx_flush(&ctx->base, log_obj);
+   if (result != VK_SUCCESS)
+      return result;
+
+   const struct gpu_point last = {
+      .timeline = ctx->timeline,
+      .value = ctx->last_point,
+   };
+   return nvkmd_stellux_wait(log_obj->device, dev->fd, &last, 1, true,
+                             UINT64_MAX);
+}
+
+const struct nvkmd_ctx_ops nvkmd_stellux_ctx_ops = {
+   .destroy = nvkmd_stellux_ctx_destroy,
+   .wait = nvkmd_stellux_ctx_wait,
+   .exec = nvkmd_stellux_ctx_exec,
+   .signal = nvkmd_stellux_ctx_signal,
+   .flush = nvkmd_stellux_ctx_flush,
+   .sync = nvkmd_stellux_ctx_sync,
+};
+
+VkResult
+nvkmd_stellux_create_ctx(struct nvkmd_dev *_dev,
+                         struct vk_object_base *log_obj,
+                         enum nvkmd_engines engines,
+                         struct nvkmd_ctx **ctx_out)
+{
+   struct nvkmd_stellux_dev *dev = nvkmd_stellux_dev(_dev);
+
+   /* Only sparse binding needs a bind ctx, and the pdev reports no sparse */
+   assert(!(engines & NVKMD_ENGINE_BIND));
+
+   struct nvkmd_stellux_ctx *ctx = CALLOC_STRUCT(nvkmd_stellux_ctx);
+   if (ctx == NULL)
+      return vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   const bool graphics = engines & (NVKMD_ENGINE_3D | NVKMD_ENGINE_COMPUTE);
+   struct gpu_queue_args queue_args = {
+      .context = dev->context,
+      .kind = graphics ? GPU_QUEUE_GRAPHICS : GPU_QUEUE_COPY,
+   };
+   if (ioctl(dev->fd, GPU_QUEUE_CREATE, &queue_args) != 0) {
+      VkResult result = nvkmd_stellux_error(log_obj,
+                                            NVKMD_STELLUX_CALL_QUEUE_CREATE,
+                                            errno);
+      FREE(ctx);
+      return result;
+   }
+
+   struct gpu_timeline_args timeline_args = { 0 };
+   if (ioctl(dev->fd, GPU_TIMELINE_CREATE, &timeline_args) != 0) {
+      VkResult result =
+         nvkmd_stellux_error(log_obj, NVKMD_STELLUX_CALL_TIMELINE_CREATE,
+                             errno);
+      destroy_queue(dev, queue_args.queue);
+      FREE(ctx);
+      return result;
+   }
+
+   ctx->base.ops = &nvkmd_stellux_ctx_ops;
+   ctx->base.dev = &dev->base;
+   ctx->queue = queue_args.queue;
+   ctx->timeline = timeline_args.timeline;
+   ctx->ranges = UTIL_DYNARRAY_INIT;
+
+   list_addtail(&ctx->link, &dev->ctxs);
+
+   *ctx_out = &ctx->base;
+
+   return VK_SUCCESS;
+}
