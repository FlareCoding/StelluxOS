+static struct wsi_image *
+wsi_stellux_swapchain_get_wsi_image(struct wsi_swapchain *wsi_chain,
+                                    uint32_t image_index)
+{
+   struct wsi_stellux_swapchain *chain =
+      (struct wsi_stellux_swapchain *)wsi_chain;
+   return &chain->images[image_index].base;
+}
+
+/* Among the images not acquired whose release point is reached, the one
+ * presented longest ago, VK_TIMEOUT if none is, or a failed poll's error */
+static VkResult
+wsi_stellux_swapchain_find_free_image(struct wsi_stellux_swapchain *chain,
+                                      uint32_t *image_index)
+{
+   VkResult found = VK_TIMEOUT;
+   uint64_t present_serial = UINT64_MAX;
+
+   for (uint32_t i = 0; i < chain->base.image_count; i++) {
+      struct wsi_image *image = &chain->images[i].base;
+      if (image->acquired || image->present_serial >= present_serial)
+         continue;
+
+      struct wsi_image_explicit_sync_timeline *release =
+         &image->explicit_sync[WSI_ES_RELEASE];
+      VkResult result = wsi_stellux_wait(chain, 1, &release->semaphore,
+                                         &release->timeline, false, 0);
+      if (result == VK_TIMEOUT)
+         continue;
+
+      if (result != VK_SUCCESS)
+         return result;
+
+      *image_index = i;
+      present_serial = image->present_serial;
+      found = VK_SUCCESS;
+   }
+
+   return found;
+}
+
+static VkResult
+wsi_stellux_swapchain_acquire_next_image(struct wsi_swapchain *wsi_chain,
+                                         const VkAcquireNextImageInfoKHR *info,
+                                         uint32_t *image_index)
+{
+   struct wsi_stellux_swapchain *chain =
+      (struct wsi_stellux_swapchain *)wsi_chain;
+
+   if (chain->retired)
+      return VK_ERROR_OUT_OF_DATE_KHR;
+
+   stlxwin_gpu_info gpu_info;
+   VkResult result =
+      wsi_stellux_surface_get_gpu_info(&chain->surface->base, &gpu_info);
+   if (result != VK_SUCCESS)
+      return result;
+
+   VkSemaphore timelines[STELLUX_MAX_IMAGES];
+   uint64_t points[STELLUX_MAX_IMAGES];
+   uint32_t count = 0;
+   for (uint32_t i = 0; i < chain->base.image_count; i++) {
+      struct wsi_image *image = &chain->images[i].base;
+      if (image->acquired)
+         continue;
+
+      timelines[count] = image->explicit_sync[WSI_ES_RELEASE].semaphore;
+      points[count] = image->explicit_sync[WSI_ES_RELEASE].timeline;
+      count++;
+   }
+
+   if (count > 0) {
+      result = wsi_stellux_wait(chain, count, timelines, points, true,
+                                os_time_get_absolute_timeout(info->timeout));
+      if (result == VK_SUCCESS)
+         result = wsi_stellux_swapchain_find_free_image(chain, image_index);
+
+      if (result != VK_TIMEOUT)
+         return result;
+   }
+
+   return info->timeout == 0 ? VK_NOT_READY : VK_TIMEOUT;
+}
