+/* Records a commit for present wait, dropping the records older than the
+ * newest whose latch point is reached, or returns the error of a poll that
+ * cannot tell */
+static VkResult
+wsi_stellux_swapchain_record_commit(struct wsi_stellux_swapchain *chain,
+                                    uint64_t present_id, VkSemaphore timeline,
+                                    uint64_t latch_point)
+{
+   /* Only presents change the records and the program serializes them, so
+    * the points are read without the mutex */
+   uint32_t first_kept = 0;
+   for (int i = chain->record_count - 1; i > 0; i--) {
+      const struct wsi_stellux_present_record *record = &chain->records[i];
+      VkResult result = wsi_stellux_wait(chain, 1, &record->timeline,
+                                         &record->latch_point, false, 0);
+      if (result == VK_SUCCESS) {
+         first_kept = i;
+         break;
+      }
+
+      /* A lost device or connection hides which latch points are reached */
+      if (result != VK_TIMEOUT)
+         return result;
+   }
+
+   mtx_lock(&chain->present_mutex);
+
+   chain->record_count -= first_kept;
+   memmove(chain->records, &chain->records[first_kept],
+           chain->record_count * sizeof(chain->records[0]));
+
+   /* A commit needs a free image, so each other image holds at most one
+    * record whose latch point is not reached */
+   assert(chain->record_count < ARRAY_SIZE(chain->records));
+   chain->records[chain->record_count++] = (struct wsi_stellux_present_record) {
+      .present_id = present_id,
+      .timeline = timeline,
+      .latch_point = latch_point,
+   };
+
+   u_cnd_monotonic_broadcast(&chain->present_recorded);
+   mtx_unlock(&chain->present_mutex);
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_stellux_swapchain_queue_present(struct wsi_swapchain *wsi_chain,
+                                    uint32_t image_index,
+                                    uint64_t present_id,
+                                    const VkPresentRegionKHR *damage)
+{
+   struct wsi_stellux_swapchain *chain =
+      (struct wsi_stellux_swapchain *)wsi_chain;
+   struct wsi_stellux_image *image = &chain->images[image_index];
+   struct wsi_image_explicit_sync_timeline *release =
+      &image->base.explicit_sync[WSI_ES_RELEASE];
+
+   /* Retirement detached every buffer, and a present on a retired
+    * swapchain may answer VK_ERROR_OUT_OF_DATE_KHR */
+   if (chain->retired)
+      return VK_ERROR_OUT_OF_DATE_KHR;
+
+   stlxwin_gpu_info gpu_info;
+   VkResult result =
+      wsi_stellux_surface_get_gpu_info(&chain->surface->base, &gpu_info);
+   if (result != VK_SUCCESS)
+      return result;
+
+   if (chain->base.present_mode == VK_PRESENT_MODE_FIFO_KHR &&
+       chain->fifo_timeline != VK_NULL_HANDLE) {
+      result = wsi_stellux_wait(chain, 1, &chain->fifo_timeline,
+                                &chain->fifo_latch_point, false,
+                                OS_TIMEOUT_INFINITE);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+
+   /* Mesa raised the release point once for this present: that value is the
+    * latch point, and one more is the new release point */
+   uint64_t latch_point = release->timeline;
+   uint64_t release_point = ++release->timeline;
+   int committed =
+      stlxwin_gpu_commit(chain->surface->window, image->buffer_id,
+                         image->base.explicit_sync[WSI_ES_ACQUIRE].timeline,
+                         latch_point, release_point, NULL, 0, 0);
+   if (committed < 0)
+      return VK_ERROR_SURFACE_LOST_KHR;
+
+   chain->fifo_timeline = release->semaphore;
+   chain->fifo_latch_point = latch_point;
+
+   if (present_id != 0) {
+      result = wsi_stellux_swapchain_record_commit(chain, present_id,
+                                                   release->semaphore,
+                                                   latch_point);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+
+   uint32_t width, height;
+   stlxwin_window_configured(chain->surface->window, &width, &height, NULL);
+   if (width != chain->extent.width || height != chain->extent.height)
+      return VK_SUBOPTIMAL_KHR;
+
+   return VK_SUCCESS;
+}
+
+/* The first record with the present id or a later one, or NULL */
+static const struct wsi_stellux_present_record *
+wsi_stellux_swapchain_find_record(const struct wsi_stellux_swapchain *chain,
+                                  uint64_t present_id)
+{
+   for (uint32_t i = 0; i < chain->record_count; i++) {
+      if (chain->records[i].present_id >= present_id)
+         return &chain->records[i];
+   }
+
+   return NULL;
+}
+
+/* Waits until an absolute deadline for the first record with the present
+ * id or a later one, checking for retirement and a loss between slices */
+static VkResult
+wsi_stellux_swapchain_wait_for_record(struct wsi_stellux_swapchain *chain,
+                                      uint64_t present_id, uint64_t deadline,
+                                      struct wsi_stellux_present_record *record)
+{
+   for (;;) {
+      mtx_lock(&chain->present_mutex);
+
+      const struct wsi_stellux_present_record *found =
+         wsi_stellux_swapchain_find_record(chain, present_id);
+      uint64_t now = os_time_get_nano();
+      if (found == NULL && !chain->retired && now < deadline) {
+         struct timespec slice_end;
+         timespec_from_nsec(&slice_end,
+                            now + MIN2(deadline - now, STELLUX_WAIT_SLICE_NS));
+         u_cnd_monotonic_timedwait(&chain->present_recorded,
+                                   &chain->present_mutex, &slice_end);
+         found = wsi_stellux_swapchain_find_record(chain, present_id);
+      }
+
+      bool retired = chain->retired;
+      if (found != NULL)
+         *record = *found;
+
+      mtx_unlock(&chain->present_mutex);
+
+      if (found != NULL)
+         return VK_SUCCESS;
+
+      /* A present refused for retirement or a lost surface ran its blit and
+       * recorded nothing */
+      if (retired)
+         return VK_ERROR_OUT_OF_DATE_KHR;
+
+      stlxwin_gpu_info gpu_info;
+      VkResult result =
+         wsi_stellux_surface_get_gpu_info(&chain->surface->base, &gpu_info);
+      if (result != VK_SUCCESS)
+         return result;
+
+      /* A present refused for a lost device recorded nothing either, and a
+       * wait on its reached present id reads the loss */
+      result =
+         wsi_swapchain_wait_for_present_semaphore(&chain->base, present_id, 0);
+      if (result != VK_SUCCESS)
+         return result;
+
+      if (os_time_get_nano() >= deadline)
+         return VK_TIMEOUT;
+   }
+}
+
+/* Waits for the present's blit, then for the latch point of the first commit
+ * with that present id or a later one */
+static VkResult
+wsi_stellux_swapchain_wait_for_present(struct wsi_swapchain *wsi_chain,
+                                       uint64_t present_id,
+                                       uint64_t timeout)
+{
+   struct wsi_stellux_swapchain *chain =
+      (struct wsi_stellux_swapchain *)wsi_chain;
+   const uint64_t deadline = os_time_get_absolute_timeout(timeout);
+
+   VkResult result =
+      wsi_swapchain_wait_for_present_semaphore(wsi_chain, present_id, timeout);
+   if (result != VK_SUCCESS)
+      return result;
+
+   /* The blit can end before its present records the commit */
+   struct wsi_stellux_present_record record;
+   result = wsi_stellux_swapchain_wait_for_record(chain, present_id, deadline,
+                                                  &record);
+   if (result != VK_SUCCESS)
+      return result;
+
+   return wsi_stellux_wait(chain, 1, &record.timeline, &record.latch_point,
+                           false, deadline);
+}
+
+/* Detaches every image's buffer and wakes the present waits still waiting
+ * for a record. stlxdm may show a detached buffer, and counts it toward the
+ * connection's budget, until its last release point is reached */
+static void
+wsi_stellux_swapchain_retire(struct wsi_stellux_swapchain *chain)
+{
+   for (uint32_t i = 0; i < chain->base.image_count; i++) {
+      struct wsi_stellux_image *image = &chain->images[i];
+      if (image->buffer_id != 0) {
+         stlxwin_gpu_detach(chain->surface->window, image->buffer_id);
+         image->buffer_id = 0;
+      }
+   }
+
+   mtx_lock(&chain->present_mutex);
+   chain->retired = true;
+   u_cnd_monotonic_broadcast(&chain->present_recorded);
+   mtx_unlock(&chain->present_mutex);
+}
+
+static void
+wsi_stellux_image_finish(struct wsi_stellux_swapchain *chain,
+                         struct wsi_stellux_image *image)
+{
+   if (image->buffer_id != 0)
+      stlxwin_gpu_detach(chain->surface->window, image->buffer_id);
+
+   if (image->buffer_fd >= 0)
+      close(image->buffer_fd);
+
+   wsi_destroy_image(&chain->base, &image->base);
+}
+
+static VkResult
+wsi_stellux_swapchain_destroy(struct wsi_swapchain *wsi_chain,
+                              const VkAllocationCallbacks *pAllocator)
+{
+   struct wsi_stellux_swapchain *chain =
+      (struct wsi_stellux_swapchain *)wsi_chain;
+
+   for (uint32_t i = 0; i < chain->base.image_count; i++)
+      wsi_stellux_image_finish(chain, &chain->images[i]);
+
+   wsi_swapchain_finish(&chain->base);
+   u_cnd_monotonic_destroy(&chain->present_recorded);
+   mtx_destroy(&chain->present_mutex);
+   vk_free(pAllocator, chain);
+
+   return VK_SUCCESS;
+}
