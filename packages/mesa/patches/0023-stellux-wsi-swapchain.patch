+/* Waits until an absolute deadline for any or all of the points, in slices
+ * with a check of the connection between them, since libstlxwin reaches
+ * every release point it holds once it finds the connection dead */
+static VkResult
+wsi_stellux_wait(const struct wsi_stellux_swapchain *chain, uint32_t count,
+                 const VkSemaphore *timelines, const uint64_t *points,
+                 bool any, uint64_t deadline)
+{
+   const struct wsi_device *wsi = chain->base.wsi;
+
+   const VkSemaphoreWaitInfo wait_info = {
+      .sType = VK_STRUCTURE_TYPE_SEMAPHORE_WAIT_INFO,
+      .flags = any ? VK_SEMAPHORE_WAIT_ANY_BIT : 0,
+      .semaphoreCount = count,
+      .pSemaphores = timelines,
+      .pValues = points,
+   };
+
+   for (;;) {
+      uint64_t now = os_time_get_nano();
+      uint64_t slice = now < deadline ?
+                       MIN2(deadline - now, STELLUX_WAIT_SLICE_NS) : 0;
+
+      VkResult result = wsi->WaitSemaphores(chain->base.device, &wait_info,
+                                            slice);
+      if (result != VK_TIMEOUT)
+         return result;
+
+      if (stlxwin_gpu_check(chain->surface->conn) < 0)
+         return VK_ERROR_SURFACE_LOST_KHR;
+
+      if (slice == 0)
+         return VK_TIMEOUT;
+   }
+}
