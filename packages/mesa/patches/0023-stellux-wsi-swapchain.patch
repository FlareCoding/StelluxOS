+static VkResult
+wsi_stellux_image_init(struct wsi_stellux_swapchain *chain,
+                       struct wsi_stellux_image *image)
+{
+   const struct wsi_device *wsi = chain->base.wsi;
+
+   image->buffer_fd = -1;
+   image->buffer_id = 0;
+
+   VkResult result = wsi_create_image(&chain->base, &chain->base.image_info,
+                                      &image->base);
+   if (result != VK_SUCCESS)
+      return result;
+
+   const VkMemoryGetFdInfoKHR get_fd_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_GET_FD_INFO_KHR,
+      .memory = image->base.blit.memory,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT,
+   };
+   result = wsi->GetMemoryFdKHR(chain->base.device, &get_fd_info,
+                                &image->buffer_fd);
+   if (result != VK_SUCCESS) {
+      wsi_stellux_image_finish(chain, image);
+      return result;
+   }
+
+   const stlxwin_gpu_buffer_desc desc = {
+      .buffer = image->buffer_fd,
+      .acquire = image->base.explicit_sync[WSI_ES_ACQUIRE].fd,
+      .release = image->base.explicit_sync[WSI_ES_RELEASE].fd,
+      .width = chain->extent.width,
+      .height = chain->extent.height,
+      .pitch = chain->base.image_info.linear_stride,
+      .format = STLXWIN_FMT_XRGB8888,
+      .offset = 0,
+   };
+   image->buffer_id = stlxwin_gpu_attach(chain->surface->window, &desc);
+   if (image->buffer_id == 0) {
+      /* get_gpu_info answers a loss, and of attach's other refusals only a
+       * full budget is the program's doing */
+      stlxwin_gpu_info gpu_info;
+      result = wsi_stellux_surface_get_gpu_info(&chain->surface->base,
+                                                &gpu_info);
+      if (result == VK_SUCCESS)
+         result = VK_ERROR_OUT_OF_HOST_MEMORY;
+
+      wsi_stellux_image_finish(chain, image);
+      return result;
+   }
+
+   return VK_SUCCESS;
+}
