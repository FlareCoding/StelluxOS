+      return result;
+
+   VkPresentModeKHR present_mode =
+      wsi_swapchain_get_present_mode(wsi_device, pCreateInfo);
+
+   uint32_t image_count = pCreateInfo->minImageCount;
+   if (present_mode == VK_PRESENT_MODE_MAILBOX_KHR)
+      image_count = MAX2(image_count, STELLUX_MAILBOX_MIN_IMAGES);
+   assert(image_count <= STELLUX_MAX_IMAGES);
+
+   struct wsi_stellux_swapchain *chain;
+   size_t size = sizeof(*chain) + image_count * sizeof(chain->images[0]);
+   chain = vk_zalloc(pAllocator, size, 8, VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   if (chain == NULL)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   if (u_cnd_monotonic_init(&chain->present_recorded) != thrd_success) {
+      vk_free(pAllocator, chain);
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+
+   mtx_init(&chain->present_mutex, mtx_plain);
+
+   const struct wsi_cpu_image_params cpu_params = {
+      .base.image_type = WSI_IMAGE_TYPE_CPU,
+   };
+   result = wsi_swapchain_init(wsi_device, &chain->base, device, pCreateInfo,
+                               &cpu_params.base, pAllocator);
+   if (result != VK_SUCCESS)
+      goto fail_destroy_present_locks;
+
+   /* stlxdm reads a linear buffer, which only the buffer blit makes, and
+    * MESA_VK_WSI_DEBUG=linear turns the blit off */
+   if (chain->base.blit.type != WSI_SWAPCHAIN_BUFFER_BLIT) {
+      result = VK_ERROR_INITIALIZATION_FAILED;
+      wsi_swapchain_finish(&chain->base);
+      goto fail_destroy_present_locks;
+   }
+
+   /* stlxdm reads an exported buffer, waits on the image's acquire
+    * timeline and raises its release timeline itself */
+   chain->base.image_info.explicit_sync = true;
+   chain->base.image_info.select_blit_dst_memory_type =
+      wsi_stellux_select_buffer_memory_type;
+   chain->base.image_info.create_mem = wsi_stellux_create_buffer_mem;
+
+   chain->base.destroy = wsi_stellux_swapchain_destroy;
+   chain->base.get_wsi_image = wsi_stellux_swapchain_get_wsi_image;
+   chain->base.acquire_next_image = wsi_stellux_swapchain_acquire_next_image;
+   chain->base.release_images = wsi_stellux_swapchain_release_images;
+   chain->base.queue_present = wsi_stellux_swapchain_queue_present;
+   chain->base.wait_for_present = wsi_stellux_swapchain_wait_for_present;
+   chain->base.wait_for_present2 = wsi_stellux_swapchain_wait_for_present;
+   chain->base.present_mode = present_mode;
+   chain->surface = surface;
+   chain->extent = pCreateInfo->imageExtent;
+
+   chain->base.image_count = image_count;
+
+   uint32_t image = 0;
+   for (; image < image_count; image++) {
+      result = wsi_stellux_image_init(chain, &chain->images[image]);
+      if (result != VK_SUCCESS)
+         goto fail_finish_images;
+   }
+
+   *swapchain_out = &chain->base;
+
+   return VK_SUCCESS;
+
+fail_finish_images:
+   while (image-- > 0)
+      wsi_stellux_image_finish(chain, &chain->images[image]);
+
+   wsi_swapchain_finish(&chain->base);
+
+fail_destroy_present_locks:
+   u_cnd_monotonic_destroy(&chain->present_recorded);
+   mtx_destroy(&chain->present_mutex);
+   vk_free(pAllocator, chain);
+
+   return result;
 }
 
 VkResult
