+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "nvkmd_stellux.h"
+
+#include "nvk_device.h"
+
+#include "util/os_time.h"
+#include "util/stack_array.h"
+#include "vk_device.h"
+#include "vk_log.h"
+
+#include <errno.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+/* The longest a wait sleeps in the kernel before a device check */
+#define NVKMD_STELLUX_WAIT_SLICE_NS (100ull * 1000 * 1000)
+
+/* How often a wait for any of over GPU_POINTS_MAX points polls the rest */
+#define NVKMD_STELLUX_WAIT_ANY_SLICE_NS (1000ull * 1000)
+
+static struct nvkmd_stellux_sync *
+to_stellux_sync(struct vk_sync *sync)
+{
+   return container_of(sync, struct nvkmd_stellux_sync, base);
+}
+
+/* A timeline belongs to no GPU, so every GPU's file takes its calls */
+static int
+sync_gpu_fd(const struct vk_sync *sync)
+{
+   const struct nvkmd_stellux_pdev *pdev =
+      container_of(sync->type, struct nvkmd_stellux_pdev, sync_type);
+
+   return pdev->fd;
+}
+
+/* The device check: the runtime's lost state, then the kernel's state of the
+ * device's context, which a device made with no queues lacks
+ */
+static VkResult
+check_device(struct vk_device *device, bool fresh)
+{
+   if (vk_device_is_lost_no_report(device))
+      return VK_ERROR_DEVICE_LOST;
+
+   struct nvkmd_dev *dev = container_of(device, struct nvk_device, vk)->nvkmd;
+   if (dev == NULL)
+      return VK_SUCCESS;
+
+   return nvkmd_stellux_dev_check(nvkmd_stellux_dev(dev), device, fresh);
+}
+
+/* A timeline's failed mark loses the device that reads it, since a reader
+ * cannot tell which of its points the failed work would have reached
+ */
+static VkResult
+query_timeline(struct vk_device *device, int fd, int timeline,
+               uint64_t *value_out)
+{
+   struct gpu_timeline_args args = {
+      .timeline = timeline,
+   };
+   if (ioctl(fd, GPU_TIMELINE_QUERY, &args) != 0) {
+      return nvkmd_stellux_error(&device->base,
+                                 NVKMD_STELLUX_CALL_TIMELINE_QUERY, errno);
+   }
+
+   if (args.flags & GPU_TIMELINE_FAILED) {
+      return vk_device_set_lost(device, "Work that would reach a timeline "
+                                "point failed");
+   }
+
+   if (value_out != NULL)
+      *value_out = args.value;
+
+   return VK_SUCCESS;
+}
+
+/* A wait for all must name at most GPU_POINTS_MAX points, the most the
+ * kernel takes, or it can end before the rest are reached
+ */
+static VkResult
+wait_points(struct vk_device *device, int fd,
+            const struct gpu_point *points, uint32_t count, bool all,
+            uint64_t abs_timeout_ns)
+{
+   const uint32_t kernel_count = MIN2(count, GPU_POINTS_MAX);
+   const uint64_t slice_ns = count > GPU_POINTS_MAX
+                             ? NVKMD_STELLUX_WAIT_ANY_SLICE_NS
+                             : NVKMD_STELLUX_WAIT_SLICE_NS;
+
+   while (true) {
+      const uint64_t slice_end_ns =
+         MIN2(abs_timeout_ns,
+              (uint64_t)os_time_get_absolute_timeout(slice_ns));
+
+      struct gpu_wait_args args = {
+         .points = (uintptr_t)points,
+         .deadline_ns = slice_end_ns,
+         .count = kernel_count,
+         .flags = all ? GPU_WAIT_ALL : 0,
+      };
+
+      /* A retry keeps the slice's deadline, so signal handlers cannot put
+       * off the device check
+       */
+      int ret;
+      do {
+         ret = ioctl(fd, GPU_TIMELINE_WAIT, &args);
+      } while (ret != 0 && errno == EINTR);
+
+      if (ret == 0)
+         return VK_SUCCESS;
+
+      if (errno != ETIMEDOUT) {
+         return nvkmd_stellux_error(&device->base,
+                                    NVKMD_STELLUX_CALL_TIMELINE_WAIT, errno);
+      }
+
+      for (uint32_t i = kernel_count; i < count; i++) {
+         uint64_t value;
+         VkResult result = query_timeline(device, fd, points[i].timeline,
+                                          &value);
+         if (result != VK_SUCCESS)
+            return result;
+
+         if (value >= points[i].value)
+            return VK_SUCCESS;
+      }
+
+      VkResult result = check_device(device, false);
+      if (result != VK_SUCCESS)
+         return result;
+
+      if (slice_end_ns == abs_timeout_ns)
+         return VK_TIMEOUT;
+   }
+}
+
+static VkResult
+nvkmd_stellux_sync_init(struct vk_device *device, struct vk_sync *_sync,
+                        uint64_t initial_value)
+{
+   struct nvkmd_stellux_sync *sync = to_stellux_sync(_sync);
+
+   struct gpu_timeline_args args = {
+      .value = initial_value,
+   };
+   if (ioctl(sync_gpu_fd(_sync), GPU_TIMELINE_CREATE, &args) != 0) {
+      return nvkmd_stellux_error(&device->base,
+                                 NVKMD_STELLUX_CALL_TIMELINE_CREATE, errno);
+   }
+
+   sync->timeline = args.timeline;
+
+   return VK_SUCCESS;
+}
+
+static void
+nvkmd_stellux_sync_finish(struct vk_device *device, struct vk_sync *_sync)
+{
+   close(to_stellux_sync(_sync)->timeline);
+}
+
+static VkResult
+nvkmd_stellux_sync_signal(struct vk_device *device, struct vk_sync *_sync,
+                          uint64_t value)
+{
+   struct nvkmd_stellux_sync *sync = to_stellux_sync(_sync);
+
+   struct gpu_timeline_args args = {
+      .timeline = sync->timeline,
+      .value = value,
+   };
+   if (ioctl(sync_gpu_fd(_sync), GPU_TIMELINE_SIGNAL, &args) == 0)
+      return VK_SUCCESS;
+
+   /* The point is reached already, as when failed work raised the timeline,
+    * whose mark a later read of its value or successful wait finds
+    */
+   if (errno == EINVAL)
+      return VK_SUCCESS;
+
+   return nvkmd_stellux_error(&device->base,
+                              NVKMD_STELLUX_CALL_TIMELINE_SIGNAL, errno);
+}
+
+static VkResult
+nvkmd_stellux_sync_get_value(struct vk_device *device, struct vk_sync *_sync,
+                             uint64_t *value)
+{
+   struct nvkmd_stellux_sync *sync = to_stellux_sync(_sync);
+
+   VkResult result = query_timeline(device, sync_gpu_fd(_sync),
+                                    sync->timeline, value);
+   if (result != VK_SUCCESS)
+      return result;
+
+   return check_device(device, false);
+}
+
+static VkResult
+nvkmd_stellux_sync_wait_many(struct vk_device *device, uint32_t wait_count,
+                             const struct vk_sync_wait *waits,
+                             enum vk_sync_wait_flags wait_flags,
+                             uint64_t abs_timeout_ns)
+{
+   if (vk_device_is_lost_no_report(device))
+      return VK_ERROR_DEVICE_LOST;
+
+   STACK_ARRAY(struct gpu_point, points, wait_count);
+   if (points == NULL)
+      return vk_error(device, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   for (uint32_t i = 0; i < wait_count; i++) {
+      points[i] = (struct gpu_point) {
+         .timeline = to_stellux_sync(waits[i].sync)->timeline,
+         .value = waits[i].wait_value,
+      };
+   }
+
+   const int fd = sync_gpu_fd(waits[0].sync);
+
+   VkResult result = VK_SUCCESS;
+   if (wait_flags & VK_SYNC_WAIT_ANY) {
+      result = wait_points(device, fd, points, wait_count, false,
+                           abs_timeout_ns);
+   } else {
+      for (uint32_t start = 0; start < wait_count && result == VK_SUCCESS;
+           start += GPU_POINTS_MAX) {
+         result = wait_points(device, fd, &points[start],
+                              MIN2(wait_count - start, GPU_POINTS_MAX), true,
+                              abs_timeout_ns);
+         if (result == VK_SUCCESS && start + GPU_POINTS_MAX < wait_count)
+            result = check_device(device, false);
+      }
+   }
+
+   for (uint32_t i = 0; i < wait_count && result == VK_SUCCESS; i++)
+      result = query_timeline(device, fd, points[i].timeline, NULL);
+
+   STACK_ARRAY_FINISH(points);
+
+   if (result != VK_SUCCESS)
+      return result;
+
+   return check_device(device, true);
+}
+
+/* Restricts handle to both rights, or to GPU_RIGHT_READ alone when it lacks
+ * GPU_RIGHT_WRITE, so the result keeps the source's rights
+ */
+static int
+restrict_timeline(int fd, int handle, int *timeline_out)
+{
+   int err = nvkmd_stellux_restrict_handle(fd, handle,
+                                           GPU_RIGHT_READ | GPU_RIGHT_WRITE,
+                                           timeline_out);
+   if (err == EINVAL) {
+      err = nvkmd_stellux_restrict_handle(fd, handle, GPU_RIGHT_READ,
+                                          timeline_out);
+   }
+
+   return err;
+}
+
+static VkResult
+nvkmd_stellux_sync_import_opaque_fd(struct vk_device *device,
+                                    struct vk_sync *_sync, int fd)
+{
+   struct nvkmd_stellux_sync *sync = to_stellux_sync(_sync);
+   const int gpu_fd = sync_gpu_fd(_sync);
+
+   int timeline;
+   int err = restrict_timeline(gpu_fd, fd, &timeline);
+   if (err != 0)
+      return nvkmd_stellux_error(&device->base, NVKMD_STELLUX_CALL_PROBE, err);
+
+   /* A handle of this GPU's context or buffer restricts too, but only a
+    * timeline's answers a query
+    */
+   struct gpu_timeline_args args = {
+      .timeline = timeline,
+   };
+   if (ioctl(gpu_fd, GPU_TIMELINE_QUERY, &args) != 0) {
+      VkResult result = nvkmd_stellux_error(&device->base,
+                                            NVKMD_STELLUX_CALL_TIMELINE_PROBE,
+                                            errno);
+      close(timeline);
+      return result;
+   }
+
+   close(sync->timeline);
+   sync->timeline = timeline;
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvkmd_stellux_sync_export_opaque_fd(struct vk_device *device,
+                                    struct vk_sync *_sync, int *fd_out)
+{
+   struct nvkmd_stellux_sync *sync = to_stellux_sync(_sync);
+
+   int err = restrict_timeline(sync_gpu_fd(_sync), sync->timeline, fd_out);
+   if (err != 0) {
+      return nvkmd_stellux_error(&device->base, NVKMD_STELLUX_CALL_RESTRICT,
+                                 err);
+   }
+
+   return VK_SUCCESS;
+}
+
+const struct vk_sync_type nvkmd_stellux_sync_type = {
+   .size = sizeof(struct nvkmd_stellux_sync),
+   .features = VK_SYNC_FEATURE_TIMELINE |
+               VK_SYNC_FEATURE_GPU_WAIT |
+               VK_SYNC_FEATURE_CPU_WAIT |
+               VK_SYNC_FEATURE_CPU_SIGNAL |
+               VK_SYNC_FEATURE_WAIT_ANY |
+               VK_SYNC_FEATURE_WAIT_BEFORE_SIGNAL,
+   .init = nvkmd_stellux_sync_init,
+   .finish = nvkmd_stellux_sync_finish,
+   .signal = nvkmd_stellux_sync_signal,
+   .get_value = nvkmd_stellux_sync_get_value,
+   .wait_many = nvkmd_stellux_sync_wait_many,
+   .import_opaque_fd = nvkmd_stellux_sync_import_opaque_fd,
+   .export_opaque_fd = nvkmd_stellux_sync_export_opaque_fd,
+};
