+++ b/src/nouveau/vulkan/nvkmd/stellux/nvkmd_stellux_va.c
@@ -0,0 +1,196 @@
+/*
+ * Copyright (c) 2024 Collabora Ltd. and Red Hat Inc.
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "nvkmd_stellux.h"
+
+#include "util/bitscan.h"
+#include "util/u_math.h"
+#include "util/u_memory.h"
+#include "vk_log.h"
+
+#include <errno.h>
+#include <inttypes.h>
+#include <sys/ioctl.h>
+
+static VkResult MUST_CHECK
+alloc_heap_addr_locked(struct nvkmd_stellux_dev *dev,
+                       struct vk_object_base *log_obj,
+                       enum nvkmd_va_flags flags,
+                       uint64_t size_B, uint64_t align_B,
+                       uint64_t fixed_addr, uint64_t *addr_out)
+{
+   if (flags & NVKMD_VA_ALLOC_FIXED) {
+      assert(flags & NVKMD_VA_REPLAY);
+      if (fixed_addr < NVKMD_STELLUX_REPLAY_HEAP_START ||
+          fixed_addr >= NVKMD_STELLUX_REPLAY_HEAP_END) {
+         return vk_errorf(log_obj, VK_ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS,
+                          "Capture address 0x%" PRIx64 " not in the replay "
+                          "heap address range [0x%" PRIx64 ", 0x%" PRIx64 ")",
+                          fixed_addr, NVKMD_STELLUX_REPLAY_HEAP_START,
+                          NVKMD_STELLUX_REPLAY_HEAP_END);
+      }
+
+      if (fixed_addr & (align_B - 1)) {
+         return vk_errorf(log_obj, VK_ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS,
+                          "Unaligned capture address: 0x%" PRIx64, fixed_addr);
+      }
+
+      if (!util_vma_heap_alloc_addr(&dev->replay_heap, fixed_addr, size_B)) {
+         return vk_errorf(log_obj, VK_ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS,
+                          "Replay address collision: 0x%" PRIx64, fixed_addr);
+      }
+
+      *addr_out = fixed_addr;
+
+      return VK_SUCCESS;
+   }
+
+   struct util_vma_heap *heap =
+      (flags & NVKMD_VA_REPLAY) ? &dev->replay_heap : &dev->heap;
+
+   *addr_out = util_vma_heap_alloc(heap, size_B, align_B);
+   if (*addr_out == 0) {
+      return vk_errorf(log_obj, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                       "Failed to allocate virtual address range");
+   }
+
+   return VK_SUCCESS;
+}
+
+static void
+free_heap_addr(struct nvkmd_stellux_dev *dev,
+               enum nvkmd_va_flags flags,
+               uint64_t addr, uint64_t size_B)
+{
+   simple_mtx_lock(&dev->heap_mutex);
+   if (flags & NVKMD_VA_REPLAY)
+      util_vma_heap_free(&dev->replay_heap, addr, size_B);
+   else
+      util_vma_heap_free(&dev->heap, addr, size_B);
+   simple_mtx_unlock(&dev->heap_mutex);
+}
+
+/* Returns the errno of GPU_UNMAP, which removes the range on EIO too */
+static int
+unmap_range(struct nvkmd_stellux_dev *dev, uint64_t addr, uint64_t size_B)
+{
+   struct gpu_map_args args = {
+      .context = dev->context,
+      .va = addr,
+      .size = size_B,
+   };
+   if (ioctl(dev->fd, GPU_UNMAP, &args) != 0)
+      return errno;
+
+   return 0;
+}
+
+VkResult
+nvkmd_stellux_alloc_va(struct nvkmd_dev *_dev,
+                       struct vk_object_base *log_obj,
+                       enum nvkmd_va_flags flags, uint8_t pte_kind,
+                       uint64_t size_B, uint64_t align_B,
+                       uint64_t fixed_addr, struct nvkmd_va **va_out)
+{
+   struct nvkmd_stellux_dev *dev = nvkmd_stellux_dev(_dev);
+
+   if (flags & NVKMD_VA_SPARSE) {
+      return vk_errorf(log_obj, VK_ERROR_UNKNOWN,
+                       "The Stellux nvkmd has no sparse address ranges");
+   }
+
+   struct nvkmd_stellux_va *va = CALLOC_STRUCT(nvkmd_stellux_va);
+   if (va == NULL)
+      return vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   assert(util_is_power_of_two_or_zero64(align_B));
+   align_B = MAX2(align_B, _dev->pdev->bind_align_B);
+   size_B = align64(size_B, align_B);
+
+   assert((fixed_addr == 0) == !(flags & NVKMD_VA_ALLOC_FIXED));
+
+   simple_mtx_lock(&dev->heap_mutex);
+   VkResult result = alloc_heap_addr_locked(dev, log_obj, flags,
+                                            size_B, align_B,
+                                            fixed_addr, &va->base.addr);
+   simple_mtx_unlock(&dev->heap_mutex);
+   if (result != VK_SUCCESS) {
+      FREE(va);
+      return result;
+   }
+
+   va->base.ops = &nvkmd_stellux_va_ops;
+   va->base.dev = &dev->base;
+   va->base.flags = flags;
+   va->base.pte_kind = pte_kind;
+   va->base.size_B = size_B;
+
+   *va_out = &va->base;
+
+   return VK_SUCCESS;
+}
+
+static void
+nvkmd_stellux_va_free(struct nvkmd_va *_va)
+{
+   struct nvkmd_stellux_dev *dev = nvkmd_stellux_dev(_va->dev);
+   struct nvkmd_stellux_va *va = nvkmd_stellux_va(_va);
+
+   /* A mapping an unmap could not remove keeps its range out of the heap
+    * until the context ends
+    */
+   if (unmap_range(dev, va->base.addr, va->base.size_B) != ENOMEM)
+      free_heap_addr(dev, va->base.flags, va->base.addr, va->base.size_B);
+
+   FREE(va);
+}
+
+static VkResult
+nvkmd_stellux_va_bind_mem(struct nvkmd_va *_va,
+                          struct vk_object_base *log_obj,
+                          uint64_t va_offset_B,
+                          struct nvkmd_mem *_mem,
+                          uint64_t mem_offset_B,
+                          uint64_t range_B)
+{
+   struct nvkmd_stellux_dev *dev = nvkmd_stellux_dev(_va->dev);
+   struct nvkmd_stellux_mem *mem = nvkmd_stellux_mem(_mem);
+
+   assert(_mem->dev == _va->dev);
+
+   struct gpu_map_args args = {
+      .context = dev->context,
+      .buffer = mem->buffer,
+      .va = _va->addr + va_offset_B,
+      .offset = mem_offset_B,
+      .size = range_B,
+      .kind = _va->pte_kind,
+      .flags = mem->read_only ? GPU_MAP_READ_ONLY : 0,
+   };
+   if (ioctl(dev->fd, GPU_MAP, &args) != 0)
+      return nvkmd_stellux_error(log_obj, NVKMD_STELLUX_CALL_MAP, errno);
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvkmd_stellux_va_unbind(struct nvkmd_va *_va,
+                        struct vk_object_base *log_obj,
+                        uint64_t va_offset_B,
+                        uint64_t range_B)
+{
+   struct nvkmd_stellux_dev *dev = nvkmd_stellux_dev(_va->dev);
+
+   /* The va's free removes or keeps a mapping an unmap's ENOMEM left */
+   unmap_range(dev, _va->addr + va_offset_B, range_B);
+
+   return VK_SUCCESS;
+}
+
+const struct nvkmd_va_ops nvkmd_stellux_va_ops = {
+   .free = nvkmd_stellux_va_free,
+   .bind_mem = nvkmd_stellux_va_bind_mem,
+   .unbind = nvkmd_stellux_va_unbind,
+};
