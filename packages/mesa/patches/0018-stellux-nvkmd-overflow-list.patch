+/* A submission on the overflow list, whose args point at its own copies */
+struct overflow_entry {
+   struct list_head link;
+
+   struct gpu_submit_args args;
+   uint64_t private_point;
+
+   struct gpu_point waits[GPU_POINTS_MAX];
