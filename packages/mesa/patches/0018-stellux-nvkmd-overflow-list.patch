+static void
+free_entries(struct list_head *entries)
+{
+   list_for_each_entry_safe(struct overflow_entry, entry, entries, link)
+      FREE(entry);
+}
+
+/* Waits for the ctx's thread to leave its list, which the GPU drains on a
+ * live device and a loss drops, or to see the ctx stopping, and joins it
+ */
+static void
+join_overflow_thread(struct nvkmd_stellux_ctx *ctx)
+{
+   mtx_lock(&ctx->overflow_mutex);
+   while (ctx->thread_runs)
+      cnd_wait(&ctx->thread_ended, &ctx->overflow_mutex);
+   mtx_unlock(&ctx->overflow_mutex);
+
+   if (ctx->thread_joinable) {
+      thrd_join(ctx->thread, NULL);
+      ctx->thread_joinable = false;
+   }
+}
+
+/* Threads walk the dev's ctxs in device checks and the runtime's queues on a
+ * loss, so neither list may change while one runs
+ */
+static void
+join_overflow_threads(struct nvkmd_stellux_dev *dev)
+{
+   list_for_each_entry(struct nvkmd_stellux_ctx, ctx, &dev->ctxs, link)
+      join_overflow_thread(ctx);
+}
+
+/* Waits one slice for room, which the queue has once the submission
+ * GPU_QUEUE_PENDING_MAX before entry has reached its private point
+ */
+static VkResult
+wait_for_room(struct nvkmd_stellux_ctx *ctx, struct nvkmd_stellux_dev *dev,
+              const struct overflow_entry *entry)
+{
+   assert(entry->private_point > GPU_QUEUE_PENDING_MAX);
+   const struct gpu_point oldest = {
+      .timeline = ctx->timeline,
+      .value = entry->private_point - GPU_QUEUE_PENDING_MAX,
+   };
+   const uint64_t slice_end_ns =
+      os_time_get_absolute_timeout(NVKMD_STELLUX_WAIT_SLICE_NS);
+
+   VkResult result = nvkmd_stellux_wait(ctx->device, dev->fd, &oldest, 1, true,
+                                        slice_end_ns);
+   if (result == VK_SUCCESS || result == VK_TIMEOUT)
+      return result;
+
+   return vk_device_set_lost(ctx->device, "A wait for room in a full GPU "
+                             "queue failed");
+}
+
+/* The submit that put entry on the list returns success, so any error here
+ * loses the device
+ */
+static VkResult
+submit_entry(struct nvkmd_stellux_ctx *ctx, struct nvkmd_stellux_dev *dev,
+             const struct overflow_entry *entry)
+{
+   const int err = submit_ioctl(dev, &entry->args);
+   if (err == 0)
+      return VK_SUCCESS;
+
+   /* Loses the device with the kernel's reason for the lost context */
+   if (err == EIO)
+      nvkmd_stellux_dev_check(dev, ctx->device, true);
+
+   return vk_device_set_lost(ctx->device, "GPU_SUBMIT of a submission that "
+                             "a full GPU queue delayed failed: %s",
+                             strerror(err));
+}
+
+/* The head stays on the list while its wait and GPU_SUBMIT run, so the
+ * program's thread never submits past it
+ */
+static int
+serve_overflow(void *data)
+{
+   struct nvkmd_stellux_ctx *ctx = data;
+   struct nvkmd_stellux_dev *dev = nvkmd_stellux_dev(ctx->base.dev);
+
+   mtx_lock(&ctx->overflow_mutex);
+   while (!ctx->stopping && !list_is_empty(&ctx->overflow)) {
+      struct overflow_entry *head =
+         list_first_entry(&ctx->overflow, struct overflow_entry, link);
+      mtx_unlock(&ctx->overflow_mutex);
+
+      VkResult result = wait_for_room(ctx, dev, head);
+      if (result == VK_SUCCESS)
+         result = submit_entry(ctx, dev, head);
+
+      struct list_head done;
+      list_inithead(&done);
+
+      mtx_lock(&ctx->overflow_mutex);
+      if (result == VK_SUCCESS) {
+         list_move_to(&head->link, &done);
+      } else if (result != VK_TIMEOUT) {
+         list_replace(&ctx->overflow, &done);
+         list_inithead(&ctx->overflow);
+      }
+      mtx_unlock(&ctx->overflow_mutex);
+
+      free_entries(&done);
+      mtx_lock(&ctx->overflow_mutex);
+   }
+
+   ctx->thread_runs = false;
+   cnd_broadcast(&ctx->thread_ended);
+   mtx_unlock(&ctx->overflow_mutex);
+
+   return 0;
+}
+
+static VkResult
+add_overflow_entry(struct nvkmd_stellux_ctx *ctx,
+                   struct vk_object_base *log_obj,
+                   const struct gpu_submit_args *args, uint64_t private_point)
+{
+   struct overflow_entry *entry = MALLOC(sizeof(*entry) + args->commands_size);
+   if (entry == NULL)
+      return vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   entry->args = *args;
+   entry->args.waits = (uintptr_t)entry->waits;
+   entry->args.signals = (uintptr_t)entry->signals;
+   entry->args.commands = (uintptr_t)entry->commands;
+   entry->private_point = private_point;
+
+   memcpy(entry->waits, (const void *)(uintptr_t)args->waits,
+          args->wait_count * sizeof(struct gpu_point));
+   memcpy(entry->signals, (const void *)(uintptr_t)args->signals,
+          args->signal_count * sizeof(struct gpu_point));
+   if (args->commands_size != 0) {
+      memcpy(entry->commands, (const void *)(uintptr_t)args->commands,
+             args->commands_size);
+   }
+
+   mtx_lock(&ctx->overflow_mutex);
+   list_addtail(&entry->link, &ctx->overflow);
+   const bool start = !ctx->thread_runs;
+   ctx->thread_runs = true;
+   mtx_unlock(&ctx->overflow_mutex);
+
+   if (!start)
+      return VK_SUCCESS;
+
+   /* A thread that cleared thread_runs has left the list and is exiting */
+   if (ctx->thread_joinable)
+      thrd_join(ctx->thread, NULL);
+
+   ctx->thread_joinable =
+      u_thread_create(&ctx->thread, serve_overflow, ctx) == thrd_success;
+   if (ctx->thread_joinable)
+      return VK_SUCCESS;
+
+   mtx_lock(&ctx->overflow_mutex);
+   list_del(&entry->link);
+   ctx->thread_runs = false;
+   mtx_unlock(&ctx->overflow_mutex);
+
+   FREE(entry);
+
+   return vk_errorf(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY,
+                    "Could not start a thread for the submissions that a "
+                    "full GPU queue delayed");
+}
+
+/* Nothing passes a submission on the overflow list */
+static VkResult
+submit_or_overflow(struct nvkmd_stellux_ctx *ctx,
+                   struct vk_object_base *log_obj,
+                   const struct gpu_submit_args *args, uint64_t private_point)
+{
+   struct nvkmd_stellux_dev *dev = nvkmd_stellux_dev(ctx->base.dev);
+
+   mtx_lock(&ctx->overflow_mutex);
+   const bool has_overflow = !list_is_empty(&ctx->overflow);
+   mtx_unlock(&ctx->overflow_mutex);
+
+   const int err = has_overflow ? EBUSY : submit_ioctl(dev, args);
+   if (err == EBUSY)
+      return add_overflow_entry(ctx, log_obj, args, private_point);
+
+   if (err != 0) {
+      /* Loses the device with the kernel's reason for the lost context */
+      if (err == EIO)
+         nvkmd_stellux_dev_check(dev, log_obj->device, true);
+
+      return nvkmd_stellux_error(log_obj, NVKMD_STELLUX_CALL_SUBMIT, err);
+   }
+
+   return VK_SUCCESS;
+}
