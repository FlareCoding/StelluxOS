+
    simple_mtx_lock(&queue->mutex);
-   result = nvk_upload_queue_sync_locked(dev, queue);
+   result = nvk_upload_queue_sync_locked(dev, queue, &idle_mems);
    simple_mtx_unlock(&queue->mutex);
 
+   /* After the unlock, since freeing a mem waits for its GPU unmap */
+   nvk_upload_queue_drop_held_mems(dev, &idle_mems);
+
    return result;
 }
 
