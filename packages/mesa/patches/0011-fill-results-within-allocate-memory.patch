+void
+nvk_upload_queue_hold_mem(struct nvk_device *dev,
+                          struct nvk_upload_queue *queue,
+                          struct nvkmd_mem *mem)
+{
+   nvkmd_mem_ref(mem);
+
+   /* Without memory for the entry the reference is never dropped, so the
+    * mem leaks rather than being freed under the commands
+    */
+   struct nvk_upload_held_mem *held =
+      vk_zalloc(&dev->vk.alloc, sizeof(*held), 8,
+                VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   if (held == NULL)
+      return;
+
+   held->mem = mem;
+
+   simple_mtx_lock(&queue->mutex);
+
+   /* Commands still in the push run with the next flush, the others with the
+    * flushes already made
+    */
+   if (nv_push_dw_count(&queue->push) > 0)
+      held->idle_time_point = UINT64_MAX;
+   else
+      held->idle_time_point = queue->last_time_point;
+   list_addtail(&held->link, &queue->held_mems);
+
+   simple_mtx_unlock(&queue->mutex);
+}
