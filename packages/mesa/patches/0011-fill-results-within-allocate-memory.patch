Returns VK_ERROR_OUT_OF_DEVICE_MEMORY from vkAllocateMemory where the fill of
new memory (zeros or a debug pattern) fails with VK_ERROR_DEVICE_LOST or
VK_ERROR_MEMORY_MAP_FAILED, which the command does not list. A failed fill on
the upload queue, where NVK records its own writes, or a failed sync of it can
leave the fill's commands in the queue's push buffer for a later flush or
still running, so the upload queue keeps the memory until a sync finds every
flush done or the queue ends. The sync frees it after unlocking the queue,
since a free waits for the memory's GPU unmap.

--- a/src/nouveau/vulkan/nvk_device_memory.c
+++ b/src/nouveau/vulkan/nvk_device_memory.c
@@ -300,12 +300,12 @@ nvk_AllocateMemory(VkDevice device,
                                         use_zero ? 0 : 0xCAFEF00D,
                                         mem->mem->size_B);
          if (result != VK_SUCCESS)
-            goto fail_mem;
+            goto fail_upload;
 
          /* Since we don't know when the memory will be freed, sync now */
          result = nvk_upload_queue_sync(dev, &dev->upload);
          if (result != VK_SUCCESS)
-            goto fail_mem;
+            goto fail_upload;
       }
    }
 
@@ -329,7 +329,13 @@ nvk_AllocateMemory(VkDevice device,
 
    return VK_SUCCESS;
 
+fail_upload:
+   /* A failed fill or sync can leave the fill's commands to run later */
+   nvk_upload_queue_hold_mem(dev, &dev->upload, mem->mem);
 fail_mem:
+   /* vkAllocateMemory lists neither of these fill results */
+   if (result == VK_ERROR_DEVICE_LOST || result == VK_ERROR_MEMORY_MAP_FAILED)
+      result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
    nvkmd_mem_unref(mem->mem);
 fail_alloc:
    vk_device_memory_destroy(&dev->vk, pAllocator, &mem->vk);
