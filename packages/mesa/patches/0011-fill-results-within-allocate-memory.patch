+struct nvk_upload_held_mem {
+   struct nvkmd_mem *mem;
+
+   /** Link in nvk_upload_queue::held_mems */
+   struct list_head link;
+
+   /** Point after which nothing writes the mem, UINT64_MAX before a flush */
+   uint64_t idle_time_point;
+};
+
+static void
+nvk_upload_queue_drop_held_mems(struct nvk_device *dev,
+                                struct list_head *held_mems)
+{
+   list_for_each_entry_safe(struct nvk_upload_held_mem, held,
+                            held_mems, link) {
+      list_del(&held->link);
+      nvkmd_mem_unref(held->mem);
+      vk_free(&dev->vk.alloc, held);
+   }
+}
