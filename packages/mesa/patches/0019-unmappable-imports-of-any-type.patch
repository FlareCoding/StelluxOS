Imports memory without NVKMD_MEM_CAN_MAP, such as that of a Stellux
descriptor without write rights, into the type the program names,
host-visible ones included, and refuses vkMapMemory on such memory with
VK_ERROR_MEMORY_MAP_FAILED without calling the nvkmd. An opaque import must
name the type its exporter allocated from, so a read-only descriptor of
host-visible memory, which the GPU can still read, would otherwise have no
type to import into.

--- a/src/nouveau/vulkan/nvk_device_memory.c
+++ b/src/nouveau/vulkan/nvk_device_memory.c
@@ -231,20 +231,13 @@ nvk_AllocateMemory(VkDevice device,
       if (result != VK_SUCCESS)
          goto fail_alloc;
 
-      /* The program picks the type, so a host-visible one can meet an import
-       * NVK cannot map, such as a descriptor without write rights
-       */
-      if (flags & NVKMD_MEM_CAN_MAP & ~mem->mem->flags) {
-         result = vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
-                            "Imported memory cannot be mapped, but its type "
-                            "is host-visible");
-         goto fail_mem;
-      }
-
       /* We can't really assert anything for dma-bufs because they could come
-       * in from some other device.
+       * in from some other device.  A host-visible type can also hold memory
+       * NVK cannot map, such as that of a Stellux descriptor without write
+       * rights, and vkMapMemory refuses to map it.
        */
-      assert(!(flags & ~mem->mem->flags & ~NVKMD_MEM_PLACEMENT_FLAGS));
+      assert(!(flags & ~mem->mem->flags &
+               ~(NVKMD_MEM_PLACEMENT_FLAGS | NVKMD_MEM_CAN_MAP)));
    } else if (pte_kind != 0 || tile_mode != 0) {
       result = nvkmd_dev_alloc_tiled_mem(dev->nvkmd, &dev->vk.base,
                                          aligned_size, alignment,
@@ -418,6 +411,11 @@ nvk_MapMemory2KHR(VkDevice device,
                        "Memory object already mapped.");
    }
 
+   if (!(mem->mem->flags & NVKMD_MEM_CAN_MAP)) {
+      return vk_errorf(dev, VK_ERROR_MEMORY_MAP_FAILED,
+                       "Memory object cannot be mapped.");
+   }
+
    void *mem_map;
    result = nvkmd_mem_map(mem->mem, &mem->vk.base, map_flags,
                           fixed_addr, &mem_map);
