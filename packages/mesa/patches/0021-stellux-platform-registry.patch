+#ifndef VULKAN_STELLUX_H_
+#define VULKAN_STELLUX_H_ 1
+
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * VK_STLX_surface makes a VkSurfaceKHR of a stlxwin window.
+ *
+ * The program owns the connection and the window: the window must be one of
+ * the connection's, and both must outlive the surface and every swapchain
+ * made on it.
+ *
+ * Only the physical device on the /dev/gpuN whose buffers stlxdm takes can
+ * present to the surface. Its extent is the window's configured size. A
+ * dead connection, or stlxdm taking no GPU buffers, loses the surface. The
+ * size, and whether stlxdm takes GPU buffers, change only as the program
+ * dispatches the connection's events.
+ */
+
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+
+
+// VK_STLX_surface is a preprocessor guard. Do not pass it to API calls.
+#define VK_STLX_surface 1
+#define VK_STLX_SURFACE_SPEC_VERSION 1
+#define VK_STLX_SURFACE_EXTENSION_NAME "VK_STLX_surface"
+typedef VkFlags VkStelluxSurfaceCreateFlagsSTLX;
+typedef struct VkStelluxSurfaceCreateInfoSTLX {
+    VkStructureType                    sType;
+    const void*                        pNext;
+    VkStelluxSurfaceCreateFlagsSTLX    flags;
+    struct stlxwin_conn*               connection;
+    struct stlxwin_window*             window;
+} VkStelluxSurfaceCreateInfoSTLX;
+
+typedef VkResult (VKAPI_PTR *PFN_vkCreateStelluxSurfaceSTLX)(VkInstance instance, const VkStelluxSurfaceCreateInfoSTLX* pCreateInfo, const VkAllocationCallbacks* pAllocator, VkSurfaceKHR* pSurface);
+
+#ifndef VK_NO_PROTOTYPES
+#ifndef VK_ONLY_EXPORTED_PROTOTYPES
+VKAPI_ATTR VkResult VKAPI_CALL vkCreateStelluxSurfaceSTLX(
+    VkInstance                                  instance,
+    const VkStelluxSurfaceCreateInfoSTLX*       pCreateInfo,
+    const VkAllocationCallbacks*                pAllocator,
+    VkSurfaceKHR*                               pSurface);
+#endif
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
