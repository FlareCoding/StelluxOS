#version 460
#extension GL_EXT_buffer_reference : require

/* Copies a rectangle of pixels from a picture into its twin. Before its
 * dispatches, a compose copies each rectangle marked changed since the last
 * compose that read the twin. gpu_compositor.cpp defines the arguments. */

layout(local_size_x = 16, local_size_y = 16) in;

layout(buffer_reference, std430, buffer_reference_align = 4) buffer pixels {
    uint words[];
};

/* `source` and `target` are the rectangle's first pixel in each, whose rows lie `pitch` bytes apart in both */
layout(push_constant, std430) uniform copy_args {
    pixels source;
    pixels target;
    uint   pitch;
    uint   width;
    uint   height;
} args;

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= args.width || pixel.y >= args.height) {
        return;
    }

    uint index = pixel.y * (args.pitch >> 2) + pixel.x;
    args.target.words[index] = args.source.words[index];
}
